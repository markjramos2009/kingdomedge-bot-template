# KingdomEdge Algo — Self-Hosted Bot Template
# Copy this file to .env (for local dev) OR set each var in Railway → Variables.
# DO NOT commit your real .env to git — it should be in .gitignore.

# ── REQUIRED ──────────────────────────────────────────────────

# Shared secret between TradingView and this bot. Generate any random 32+ char
# string (e.g. `openssl rand -hex 32` or use a password manager). This MUST
# match the "secret" field in the JSON body of your TradingView alert.
# Treat this like a password. Rotate it periodically.
WEBHOOK_SECRET=replace_me_with_random_32_char_string

# Your Alpaca API credentials. Start with PAPER trading.
# Get these from https://app.alpaca.markets/paper/dashboard/overview
# (or https://app.alpaca.markets/live/dashboard/overview for live).
ALPACA_API_KEY=PKxxxxxxxxxxxxxxxxxx
ALPACA_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# "true" = paper trading (recommended for first 30 days)
# "false" = real money. Make sure you're ready.
ALPACA_PAPER=true


# ── OPTIONAL — runtime config ─────────────────────────────────

# Force a fixed contract count per signal (overrides signal's quantity field).
# Leave unset / 0 to respect the signal's quantity.
# Recommended during the paper-trading shakedown: set to 1.
QUANTITY_OVERRIDE=1


# ── OPTIONAL — risk control overrides (sensible defaults baked in) ──

# Max USD loss per day before kill switch engages
RISK_MAX_DAILY_LOSS=500

# Max contracts/shares per single order
RISK_MAX_POSITION_SIZE=10

# Seconds to ignore duplicate signals on the same symbol/action
RISK_COOLDOWN_SECONDS=60

# Max concurrent open positions
RISK_MAX_OPEN_POSITIONS=5

# Trading hours window (UTC) — outside this window, signals are ignored
RISK_TRADING_START_HOUR=13   # 9 AM ET
RISK_TRADING_END_HOUR=20     # 4 PM ET


# ── OPTIONAL — error tracking ─────────────────────────────────

# Sentry error tracking. If set, exceptions are sent to Sentry.
# Get a DSN at https://sentry.io
SENTRY_DSN=
SENTRY_ENVIRONMENT=production


# ── OPTIONAL — local dev only ─────────────────────────────────

# Local dev port (Railway sets PORT automatically in production)
# PORT=5000
