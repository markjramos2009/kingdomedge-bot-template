# KingdomEdge Algo — Bot Template Environment Variables
#
# Copy this file to .env and fill in your values. NEVER commit your real .env to git.
# When deploying via Railway, paste these values into Railway's Variables tab.

# ─── REQUIRED ──────────────────────────────────────────────────────────────
# These three values are required for the bot to start.

# 32-character random string. Used to authenticate webhook signals from your
# TradingView alert. Generate with one of:
#   macOS/Linux: openssl rand -hex 32
#   Windows PowerShell: -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 32 | %{[char]$_})
# Paste the SAME secret into your TradingView alert's webhook JSON message.
WEBHOOK_SECRET=

# Your Alpaca API key (starts with PK for paper, AK for live).
# Get from app.alpaca.markets → API Keys → Generate New Keys.
ALPACA_API_KEY=

# Your Alpaca API secret. Save in a password manager — Alpaca shows it ONCE.
ALPACA_API_SECRET=

# ─── OPTIONAL (sensible defaults) ──────────────────────────────────────────

# Set "true" for paper trading (recommended for first 30 days, default).
# Set "false" for live trading. Only switch when you've validated paper performance.
ALPACA_PAPER=true

# Override the signal's contract count. Recommended: 1 for the first 2 weeks
# of live trading. Set higher once you trust the bracket structure.
# Leave blank to use whatever quantity the SETS Trade signal specifies.
QUANTITY_OVERRIDE=1

# ─── RISK CONTROLS (defaults shown — override only if you have a reason) ───

# Maximum daily loss before kill switch engages. In account currency (USD).
# RISK_MAX_DAILY_LOSS=500

# Maximum simultaneous open positions across all brackets.
# RISK_MAX_OPEN_POSITIONS=5

# Cooldown between signals to prevent duplicate fills (seconds).
# RISK_COOLDOWN_SECONDS=60

# Trading hours window (UTC). NYSE default: 14:00-20:00 UTC = 7AM-1PM PT.
# RISK_TRADING_START_HOUR=14
# RISK_TRADING_END_HOUR=20

# ─── OBSERVABILITY (optional) ──────────────────────────────────────────────

# Sentry DSN for error tracking. Leave blank to skip.
# Get from sentry.io → your project → Settings → Client Keys (DSN).
SENTRY_DSN=

# Sentry environment label (production, staging, dev).
SENTRY_ENVIRONMENT=production

# ─── RAILWAY-SPECIFIC ──────────────────────────────────────────────────────
# Railway sets PORT automatically. Don't set this manually.
# PORT=8080
